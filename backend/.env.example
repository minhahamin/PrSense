# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
EMBEDDING_MODEL=text-embedding-3-small

# --- GitHub ---
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=change-me
# 콤마 구분 "owner/repo" 허용 목록 (비우면 전체 허용)
ALLOWED_REPOS=

# --- RAG / Chroma ---
CHROMA_DIR=/data/chroma
CHROMA_COLLECTION=prsense_code
RAG_TOP_K=5
CONFIDENCE_THRESHOLD=0.6

# --- Database ---
# Railway: Postgres 플러그인 추가 시 자동 주입됨 (값 비워두면 SQLite 폴백).
# 로컬 compose: postgresql://prsense:prsense@localhost:5432/prsense
DATABASE_URL=
SQLITE_PATH=

# --- App ---
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
MOCK_LLM=false
